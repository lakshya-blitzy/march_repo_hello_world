# ==============================================================================
# Environment Variables Configuration
# ==============================================================================
#
# This file documents all configurable settings for the secured Express.js
# application. It contains variable names with safe default values — NO actual
# secrets are stored here.
#
# USAGE:
#   1. Copy this file to create your local environment file:
#        cp .env.example .env
#   2. Edit .env and customize values for your environment
#   3. Never commit the .env file — it is excluded via .gitignore
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------

# HTTP server port (default: 3000, preserves original server.js default)
PORT=3000

# Server bind address
# Use 0.0.0.0 to accept connections on all network interfaces (required for
# CORS and HTTPS to be meaningful in a networked context).
# Set to 127.0.0.1 to restrict to localhost-only access.
HOST=0.0.0.0

# Application environment: "development" or "production"
# Controls security strictness — production mode hides stack traces in error
# responses and enforces stricter security defaults.
NODE_ENV=development

# ------------------------------------------------------------------------------
# HTTPS / TLS Configuration
# ------------------------------------------------------------------------------

# HTTPS server port (default: 3443)
HTTPS_PORT=3443

# Path to TLS certificate file (PEM format)
# Leave empty to disable HTTPS. For development, generate a self-signed
# certificate using: ./certs/generate-cert.sh
TLS_CERT_PATH=

# Path to TLS private key file (PEM format)
# Leave empty to disable HTTPS. Must correspond to the certificate above.
TLS_KEY_PATH=

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# ------------------------------------------------------------------------------

# Comma-separated list of allowed origins for cross-origin requests
# Use a restrictive default; add additional origins as needed.
# Example: http://localhost:3000,https://myapp.example.com
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# ------------------------------------------------------------------------------

# Rate limit window duration in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per IP address within the rate limit window
# (default: 100 requests per 15-minute window)
RATE_LIMIT_MAX=100
